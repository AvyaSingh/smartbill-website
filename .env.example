# Enquiry feature flags control which actions are visible in the contact form.
ENQUIRY_EMAIL_ENABLED=false
ENQUIRY_WHATSAPP_ENABLED=true

# Local development can leave this blank to use the Vite /api proxy.
# Set the deployed API base URL for a production website build.
API_BASE_URL=

# WhatsApp business number in international format, digits only.
WHATSAPP_NUMBER=917016701022
